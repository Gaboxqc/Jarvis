{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kai Assistant",
  "version": "0.3.0",
  "identifier": "com.gaboxqc.kai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kai",
        "width": 900,
        "height": 680,
        "minWidth": 420,
        "minHeight": 420,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8756 http://localhost:8756; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/kai-backend/**/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "shortDescription": "Personal desktop assistant",
    "longDescription": "A local assistant for your calendar, mail, files and meetings. Requires Ollama (ollama.com) for the language model; everything else is included.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Gaboxqc/Jarvis/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCN0JDNTU0NDMyMUM2MjkKUldRcHhpRkRWTVY3bTZHTm5VRndJQkx4azVuTllBbnhXMjlGcWpoeXVHc3FnbHFLNi9ML0s0N20K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
