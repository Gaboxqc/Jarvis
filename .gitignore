# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Local user data — never committed (REQ-26).
# The task Markdown mirror lives in %LOCALAPPDATA%\Kai, not in the repo, so it
# needs no rule here — and a bare `tasks.md` rule would swallow the SDD's own.
*.db
*.db-wal
*.db-shm
data/

# Your real config. Never tracked.
#
# It was tracked once, and that was a mistake. The file was designed to hold no
# secrets -- passwords live in the OS credential store -- but some connector
# values are bearer credentials in their own right. A Google "secret address in
# iCal format" grants read access to a whole calendar to anyone holding the URL,
# with no login. Committing one publishes it, and git history keeps it after the
# line is deleted.
#
# kai.config.example.yaml is the tracked template. Copy it to kai.config.yaml
# and edit that.
kai.config.yaml
kai.config.local.yaml

# Editors / OS
.idea/
.vscode/
Thumbs.db
desktop.ini

# Desktop UI build artefacts
ui/node_modules/
ui/dist/
ui/src-tauri/target/
ui/src-tauri/gen/

# `tauri icon` also emits Android/iOS/Microsoft Store variants. Only the five
# referenced in tauri.conf.json are needed; the rest regenerate on demand.
ui/src-tauri/icons/android/
ui/src-tauri/icons/ios/
ui/src-tauri/icons/Square*Logo.png
ui/src-tauri/icons/StoreLogo.png
ui/src-tauri/icons/64x64.png
